// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum EnquiryStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  QUOTATION_SENT
  CONFIRMED
  CLOSED
  CANCELLED
}

model Enquiry {
  id                  String        @id @default(cuid())
  bookingId           String?       @unique // e.g. BV-123456
  name                String
  phone               String
  email               String?
  destination         String        @default("Maheshwar & Jam Gate (Indore Departure)")
  travelDate          String        // Specific date or travel month/season
  travellers          Int           @default(1)
  pickupPoint         String?       // Selected Indore pickup point
  customPickupRequest String?       // Custom stop/pickup request
  amountPerPerson     Int?          // e.g. 699
  discountApplied     Int?          // Group discount amount
  totalAmount         Int?          // Final calculated amount
  budget              String?
  message             String?       @db.Text
  notes               String?       @db.Text
  status              EnquiryStatus @default(NEW)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([bookingId])
}


